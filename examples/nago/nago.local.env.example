# 复制为 nago.local.env 并填入真实值（nago.local.env 已在 .gitignore）
#
# cp nago.local.env.example nago.local.env

# OpenAI 兼容 chat/completions 完整 URL
NAGO_AI_ENDPOINT=http://localhost:11434/v1/chat/completions

# API Key（勿提交仓库）
NAGO_AI_API_KEY=

# 模型名（可稍后更换）
NAGO_AI_MODEL=llama3.2

# 请求超时（秒）
NAGO_AI_TIMEOUT=20

# 无事件时慢心跳（毫秒）
NAGO_HEARTBEAT_MS=6000

# hover/点击/前台切换等事件的 debounce（毫秒）
NAGO_EVENT_DEBOUNCE_MS=400

# 气泡自动收起（毫秒）
NAGO_SPEECH_BUBBLE_MS=3500
