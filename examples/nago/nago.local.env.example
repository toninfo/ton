# Copy this file to nago.local.env and provide real values (nago.local.env is gitignored).
#
# cp nago.local.env.example nago.local.env

# Full URL of an OpenAI-compatible chat/completions endpoint.
NAGO_AI_ENDPOINT=http://localhost:11434/v1/chat/completions

# API key (do not commit it).
NAGO_AI_API_KEY=

# Model name (can be changed later).
NAGO_AI_MODEL=llama3.2

# Request timeout in seconds.
NAGO_AI_TIMEOUT=20

# Slow heartbeat interval while no events occur, in milliseconds.
NAGO_HEARTBEAT_MS=6000

# Debounce interval for hover, click, foreground-switch, and similar events, in milliseconds.
NAGO_EVENT_DEBOUNCE_MS=400

# Speech-bubble auto-dismiss delay in milliseconds.
NAGO_SPEECH_BUBBLE_MS=3500

# Minimum seconds between spontaneous bubbles (ambient speech is blocked entirely).
NAGO_MIN_SPEECH_GAP_SEC=90

# Session memory: compress older entries after exceeding the total character limit.
NAGO_SESSION_MAX_CHARS=10000
NAGO_SESSION_KEEP_RECENT_CHARS=2500
NAGO_MEMORY_MAX_FACTS=40
